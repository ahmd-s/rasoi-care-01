<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Every real network call this app makes (Firebase Auth/Firestore/
         Storage, the RasoiCare backend) needs this — previously only
         declared in the debug/profile manifest variants, so a release
         build depended entirely on some bundled dependency merging its
         own INTERNET permission in rather than this app declaring it. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Live GPS reporting to Firestore while on duty and working a job, so
         the Customer app's tracking screen can show this technician on a
         map — see lib/state/technician_location_reporter.dart. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 13+ (API 33+) requires this permission for foreground location access -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Don't block install on devices without a location radio — reporting
         just stays off (permission/service check fails gracefully). -->
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Before/after job photos (TechJobScreen) — real camera capture via
         image_picker, not the old fake "mock camera" counter. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Fingerprint/face unlock, offered after sign-up — see BiometricService -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:label="Rasoi Care Partner"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <!-- Job-tracking map (TechJobScreen) — key sourced from the
             ${mapsApiKey} placeholder in build.gradle.kts, defaults to an
             empty string so the build never fails for its absence. See
             lib/core/config/maps_config.dart. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher (TechJobScreen's Navigate action) needs these
             declared for Android 11+ package visibility, or it can't find
             Google Maps / a browser to hand the URL to. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <!-- url_launcher's real "Call" action on the job screen (a plain
             tel: dialer intent, no telephony integration needed) — Android
             11+ package visibility again. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>
</manifest>
